{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"noEmit": true,
		"types": ["node"],
		"rootDir": "./src"
	},
	"include": ["./src/**/*.ts"]
}
